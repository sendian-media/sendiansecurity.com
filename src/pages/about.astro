---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ActionLink from '@/components/ui/ActionLink.astro';
import { about } from '@/data/about';
---

<BaseLayout title="About Us | Sendian Integrated Security Services" description="Sendian Integrated Security Services (SISS) is a Qatar-based systems integrator delivering integrated security, ELV, ICT, and automation solutions." socialImage={about.intro.mainImage}>
  <section class="about-hero relative flex h-[350px] w-full items-center overflow-hidden rounded-b-[30px] shadow-lg md:h-[400px]" aria-label="About banner">
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 md:px-20 home-reveal d1">
      <h1 class="text-5xl font-bold leading-tight text-white md:text-[68px]">{about.hero.title}</h1>
    </div>
  </section>

  <nav class="mb-20 w-full bg-[#F9FAFB] px-6 py-4 md:px-20" aria-label="Breadcrumb">
    <div class="mx-auto max-w-7xl text-sm">
      <a class="font-medium text-[#ef3e4a] hover:underline" href="/">Home</a>
      <span class="mx-2 text-gray-400" aria-hidden="true">/</span>
      <span class="text-gray-600" aria-current="page">{about.hero.breadcrumb}</span>
    </div>
  </nav>

  <div>
    <!-- Intro: image left / text right -->
    <section class="mx-auto mb-24 max-w-7xl px-6 md:px-12">
      <div class="flex flex-col items-stretch gap-16 lg:flex-row">
        <div class="w-full lg:w-5/12">
          <img class="home-reveal d1 h-auto w-full rounded-[16px] object-cover" src={about.intro.mainImage} alt={about.intro.mainAlt} width="1024" height="1536" loading="lazy" decoding="async" />
        </div>
        <div class="w-full lg:w-7/12">
          <p class="mb-6 home-reveal d3"><span class="badge-outline uppercase">// {about.intro.badge}</span></p>
          <h2 class="mb-8 text-4xl font-bold leading-[1.1] text-[var(--link)] sm:text-[52px] home-reveal d3" set:html={about.intro.title} />
          <div class="mb-8 text-[17px] leading-relaxed text-[#8f91ab] home-reveal d4">
            {about.intro.paragraphs.map((paragraph) => <p class="mb-6 last:mb-0">{paragraph}</p>)}
          </div>
        </div>
      </div>
    </section>

    <!-- Our approach: three highlight cards -->
    <section class="mb-24 bg-[#F8F9FA] px-6 py-20 md:px-12">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2 class="mx-auto max-w-3xl text-4xl font-bold leading-tight text-[var(--link)] home-reveal d1" set:html={about.approach.title} />
        </div>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          {about.approach.highlights.map((highlight) => (
            <div class="approach-card home-reveal d3">
              <h3 class="text-lg font-bold text-[var(--link)]">{highlight.title}</h3>
              <span class="approach-divider" aria-hidden="true"></span>
              <p class="m-0 text-[15px] leading-relaxed text-[#8f91ab]">{highlight.caption}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Vision & mission -->
    <section class="mx-auto mb-24 max-w-7xl px-6 md:px-12">
      <div class="flex flex-col items-center gap-16 lg:flex-row">
        <div class="w-full lg:w-1/2">
          <img class="home-reveal d2 mx-auto w-full max-w-md rounded-[16px] object-cover" src={about.visionMission.image} alt={about.visionMission.imageAlt} width="850" height="930" loading="lazy" decoding="async" />
        </div>
        <div class="grid w-full gap-10 lg:w-1/2">
          <div class="flex items-start gap-6 home-reveal d8">
            <img class="size-14 shrink-0" src={about.visionMission.vision.icon} alt="" width="200" height="200" loading="lazy" decoding="async" />
            <div>
              <h3 class="mb-2 text-2xl font-bold text-[var(--link)]">{about.visionMission.vision.title}</h3>
              <p class="m-0 text-[15px] leading-relaxed text-[#8f91ab]">{about.visionMission.vision.caption}</p>
            </div>
          </div>
          <div class="flex items-start gap-6 home-reveal d6">
            <img class="size-14 shrink-0" src={about.visionMission.mission.icon} alt="" width="200" height="200" loading="lazy" decoding="async" />
            <div>
              <h3 class="mb-2 text-2xl font-bold text-[var(--link)]">{about.visionMission.mission.title}</h3>
              <p class="m-0 text-[15px] leading-relaxed text-[#8f91ab]">{about.visionMission.mission.caption}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Integrated capability framework -->
    <section class="mb-24 px-6 md:px-12">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <p class="mb-6 home-reveal d1"><span class="badge-outline uppercase">// {about.capability.badge}</span></p>
          <h2 class="mx-auto max-w-3xl text-4xl font-bold leading-tight text-[var(--link)] home-reveal d1" set:html={about.capability.title} />
        </div>

        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-3 lg:gap-8">
          <div class="grid gap-10">
            {about.capability.cards.slice(0, 3).map((card) => (
              <div class="capability-card home-reveal home-reveal--left d3">
                <img class="size-12 wobble-skew" src={card.icon} alt="" width="60" height="60" loading="lazy" decoding="async" />
                <h3 class="mb-2 mt-4 text-lg font-bold text-[var(--link)]">{card.title}</h3>
                <p class="m-0 text-[15px] leading-relaxed text-[#8f91ab]">{card.caption}</p>
              </div>
            ))}
          </div>

          <div class="order-first flex items-center justify-center lg:order-none">
            <img class="home-reveal d1 mx-auto w-full max-w-xs object-contain" src={about.capability.image} alt={about.capability.imageAlt} width="688" height="713" loading="lazy" decoding="async" />
          </div>

          <div class="grid gap-10">
            {about.capability.cards.slice(3).map((card) => (
              <div class="capability-card home-reveal home-reveal--left d3">
                <img class="size-12 wobble-skew" src={card.icon} alt="" width="60" height="60" loading="lazy" decoding="async" />
                <h3 class="mb-2 mt-4 text-lg font-bold text-[var(--link)]">{card.title}</h3>
                <p class="m-0 text-[15px] leading-relaxed text-[#8f91ab]">{card.caption}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Certifications -->
    <section class="bg-[#F8F9FA] px-6 py-20 md:px-12">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <p class="mb-6 home-reveal d1"><span class="badge-outline uppercase">// {about.certifications.badge}</span></p>
          <h2 class="text-4xl font-bold leading-tight text-[var(--link)] home-reveal d2" set:html={about.certifications.title} />
          <p class="mt-6 text-[17px] leading-relaxed text-[#8f91ab] home-reveal d3">{about.certifications.description}</p>
        </div>

        <div class="grid grid-cols-2 gap-5 md:grid-cols-3 lg:gap-6 xl:grid-cols-5">
          {about.certifications.items.map((certificate, index) => (
            <article class:list={['certificate-card home-reveal', `d${index + 1}`]}>
              <img class="w-full" src={certificate.image} alt={`${certificate.title} certificate for Sendian Group`} width="955" height="1350" loading="lazy" decoding="async" />
              <div class="p-4 text-center">
                <h3 class="text-base font-bold text-[var(--link)]">{certificate.title}</h3>
                <p class="mt-1 text-xs leading-relaxed text-[#8f91ab]">{certificate.caption}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-20 text-center md:px-12">
      <div class="mx-auto max-w-2xl">
        <h2 class="text-3xl font-bold leading-tight text-[var(--link)] home-reveal d1">Ready to discuss your requirements?</h2>
        <p class="mt-4 text-[17px] leading-relaxed text-[#8f91ab] home-reveal d2">Our team is ready to help you plan a secure, integrated solution.</p>
        <ActionLink href="/contact" badge class="mt-8 home-reveal d3">Contact us</ActionLink>
      </div>
    </section>
  </div>

</BaseLayout>

<style is:global>
  .about-hero {
    background-color: #2c3a55;
    background-image:
      url('/images/home/hero.webp'),
      radial-gradient(circle at 70% 50%, rgb(255 255 255 / 0.05) 0%, transparent 50%),
      radial-gradient(circle at 30% 80%, rgb(255 255 255 / 0.03) 0%, transparent 40%);
    background-blend-mode: overlay, normal, normal;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .about-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(44 58 85 / 0.92);
  }
  .badge-outline {
    border: 1px solid var(--highlight);
    border-radius: 999px;
    color: var(--highlight);
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.5rem 1.25rem;
  }
  .approach-card {
    background: #fff;
    border-radius: 12px;
    padding: 2rem;
  }
  .approach-divider {
    background: var(--highlight);
    display: inline-block;
    height: 3px;
    width: 3rem;
    margin: 0.9rem 0 1rem;
    border-radius: 999px;
  }
  .capability-card { text-align: left; }
  .certificate-card {
    background: #fff;
    border: 1px solid rgb(0 0 0 / 0.1);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgb(44 58 85 / 0.08);
    overflow: hidden;
  }
  .certificate-card img { aspect-ratio: 955 / 1350; object-fit: cover; }

  @media (min-width: 96rem) {
    .about-hero + nav + div .mx-auto.max-w-7xl { max-width: 90rem; }
    .about-hero + nav + div h2.text-4xl { font-size: clamp(2.5rem, 3.2vw, 3.6rem); }
    .about-hero + nav + div .approach-card { padding: 2.25rem; }
  }

  /* Source animations: card icons wobble on hover */
  @keyframes wobble-skew {
    16.65% { transform: skew(-12deg); }
    33.3% { transform: skew(10deg); }
    49.95% { transform: skew(-6deg); }
    66.6% { transform: skew(4deg); }
    83.25% { transform: skew(-2deg); }
    100% { transform: skew(0); }
  }
  .wobble-skew:hover { animation: wobble-skew 1s ease-in-out; }
</style>
