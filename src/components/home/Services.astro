---
import { home } from '@/data/home';
import Eyebrow from './Eyebrow.astro';
import ActionLink from '@/components/ui/ActionLink.astro';
---

<section id="services" class="scroll-mt-20 bg-white py-20">
  <div class="container mx-auto px-8 text-center">
    <Eyebrow class="home-reveal d1">Our Services</Eyebrow>
    <h2 class="section-title home-reveal d2 mx-auto max-w-3xl">Comprehensive <span class="text-[var(--brand)]">Security &amp; Technology</span> Solutions</h2>
    <p class="home-reveal d3 mx-auto max-w-3xl text-gray-600">From Ministry of Interior-approved CCTV surveillance to enterprise networking and smart infrastructure, SISS delivers integrated security solutions tailored to Qatar’s government, commercial, and industrial sectors.</p>
  </div>

  <div class="services-viewport home-reveal d5" role="region" aria-label="Our services">
    <div class="services-track" id="services-track">
      {home.services.map((service, index) => (
        <a class:list={['service-card home-reveal home-reveal--media', `d${index + 1}`]} href={service.href}>
          <span class="service-card__media">
            <img src={service.image} alt={service.alt} width="800" height="950" loading="lazy" decoding="async" />
          </span>
          <span class="service-card__overlay">
            <span>{service.title}</span>
          </span>
        </a>
      ))}
    </div>
  </div>

  <p class="home-reveal d8 mt-12 text-center"><ActionLink href="/services" badge>View All Services</ActionLink></p>
</section>

<style>
  .services-viewport {
    margin: 3rem auto 0;
    max-width: 80rem;
    position: relative;
    width: 100%;
  }

  .services-track {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: 100%;
  }

  .service-card {
    aspect-ratio: 800 / 950;
    min-width: 0;
    overflow: hidden;
    position: relative;
    border-radius: 0.625rem;
  }

  .service-card__media,
  .service-card img {
    display: block;
    height: 100%;
    width: 100%;
  }

  .service-card img {
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .service-card:hover img,
  .service-card:focus-visible img { transform: scale(1.1); }

  .service-card__overlay {
    align-items: end;
    background: linear-gradient(to top, rgb(0 0 0 / 0.8) 0%, transparent 70%);
    color: white;
    display: flex;
    font-size: 1.25rem;
    font-weight: 700;
    inset: 0;
    line-height: 1.25;
    padding: 1.5rem;
    position: absolute;
  }

  .service-card__overlay > span { max-width: 75%; }

  @media (max-width: 767px) {
    .services-viewport { margin-top: 2.5rem; }
    .services-track {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      padding-inline: 1rem;
      scrollbar-width: none;
    }

    .services-track::-webkit-scrollbar { display: none; }
    .service-card { flex: 0 0 calc(100vw - 4rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card img { transition: none; }
  }
</style>
