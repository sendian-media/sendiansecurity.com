---
import FloatingWhatsApp from '@/components/ui/FloatingWhatsApp.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projectDetails } from '@/data/projects';

export async function getStaticPaths() {
  return projectDetails.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.title} Projects | Sendian Integrated Security Services`} description={project.intro[0]}>
  <div class="px-4 pt-4">
    <section class="detail-hero relative rounded-3xl px-6 pb-32 pt-24 text-white md:px-8" aria-label={`${project.title} banner`}>
      <div class="relative z-10 mx-auto max-w-7xl">
        <h1 class="mb-4 text-5xl font-bold leading-tight md:text-[68px]">{project.title}</h1>
      </div>
    </section>
  </div>

  <div class="relative z-20 -mt-6 mx-4 rounded-b-3xl border border-gray-100 bg-gray-50 px-6 py-4 text-sm shadow-sm md:px-8">
    <div class="mx-auto max-w-7xl">
      <a class="font-medium text-[#ef3e4a] hover:underline" href="/">Home</a>
      <span class="mx-2 text-gray-400" aria-hidden="true">/</span>
      <a class="font-medium text-[#ef3e4a] hover:underline" href="/projects">Projects</a>
      <span class="mx-2 text-gray-400" aria-hidden="true">/</span>
      <span class="text-gray-700" aria-current="page">{project.title}</span>
    </div>
  </div>

  <main class="mx-auto w-full max-w-7xl flex-grow px-6 py-16 md:px-8">
    <!-- Intro -->
    <section class="mb-24">
      <div class="max-w-4xl space-y-6 text-lg leading-relaxed text-gray-500">
        {project.intro.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <!-- Our Challenge -->
    <section class="mb-24">
      <h2 class="mb-6 text-3xl font-bold text-[#2C3A55] md:text-[36px]">Our Challenge</h2>
      <p class="mb-12 max-w-4xl text-lg leading-relaxed text-gray-500">{project.challengeIntro}</p>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {project.challengeItems.map((item) => (
          <div class="overflow-hidden rounded-[10px] border border-gray-100 bg-gray-50 shadow-sm">
            <img class="h-[200px] w-full object-cover" src={item.image} alt={item.title} width="800" height="533" loading="lazy" decoding="async" />
            <div class="p-6">
              <h3 class="mb-2 text-xl font-bold text-[#2C3A55]">{item.title}</h3>
              <p class="text-sm leading-relaxed text-gray-600">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Our Solution -->
    <section class="mb-24">
      <h2 class="mb-6 text-3xl font-bold text-[#2C3A55] md:text-[36px]">Our Solution</h2>
      <p class="mb-8 max-w-4xl text-lg leading-relaxed text-gray-500">{project.solution.text}</p>
      {project.solution.bullets.length > 0 && (
        <ul class="grid max-w-4xl grid-cols-1 gap-4 md:grid-cols-2">
          {project.solution.bullets.map((bullet) => (
            <li class="flex items-start gap-3 text-gray-600">
              <span class="mt-1.5 size-2 shrink-0 rounded-full bg-[#4b7cd3]" aria-hidden="true"></span>
              <span class="text-[15px]">{bullet}</span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <!-- Result Driven -->
    <section>
      <h2 class="mb-6 text-3xl font-bold text-[#2C3A55] md:text-[36px]">Result Driven</h2>
      <p class="mb-8 max-w-4xl text-lg leading-relaxed text-gray-500">{project.results.text}</p>
      {project.results.bullets.length > 0 && (
        <ul class="grid max-w-4xl grid-cols-1 gap-4 md:grid-cols-3">
          {project.results.bullets.map((bullet) => (
            <li class="flex items-start gap-3 rounded-[10px] bg-gray-50 p-4 text-gray-600">
              <span class="mt-1.5 size-2 shrink-0 rounded-full bg-[#4b7cd3]" aria-hidden="true"></span>
              <span class="text-[15px]">{bullet}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  </main>

  <FloatingWhatsApp />
</BaseLayout>

<style is:global>
  .detail-hero {
    background: linear-gradient(135deg, #1b263b 0%, #172a45 100%);
    overflow: hidden;
    position: relative;
  }
  .detail-hero::before {
    background-image: radial-gradient(circle at 70% 50%, rgb(255 255 255 / 0.05) 0%, transparent 50%);
    content: '';
    inset: 0;
    pointer-events: none;
    position: absolute;
  }
  .detail-hero::after {
    background-image: url("data:image/svg+xml,%3Csvg width='100%25' height='100%25' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0,0 L100,100 M100,0 L0,100' stroke='%23fff' stroke-width='1'/%3E%3C/svg%3E");
    content: '';
    inset: 0;
    opacity: 0.1;
    pointer-events: none;
    position: absolute;
  }
</style>
