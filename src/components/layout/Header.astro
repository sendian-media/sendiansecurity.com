---
import { navigation, site } from '@/data/site';
import ChevronIcon from '@/components/ui/ChevronIcon.astro';
import ActionLink from '@/components/ui/ActionLink.astro';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="header sticky top-0 z-50 flex w-full items-center justify-between bg-white px-6 shadow-sm md:px-8">
  <a class="flex shrink-0 items-center py-5" href="/" aria-label={`${site.name} home`}>
    <img
      class="h-9 w-auto md:h-[52px]"
      src="/images/home/logo-header.png"
      alt=""
      width="864"
      height="291"
      decoding="async"
    />
  </a>
  <nav class="hidden self-stretch md:block" aria-label="Primary navigation">
    <ul class="m-0 flex h-full list-none items-center gap-8 p-0 xl:gap-10">
      {navigation.map(({ href, label, submenu }) => (
        <li class:list={["header-nav-item relative", submenu && "header-nav-item--parent"]}>
          <a
            class:list={["flex items-center text-[18px] font-medium", isActive(href) ? 'text-[var(--brand)]' : 'text-[#3e4a5c] hover:text-[var(--brand)]']}
            aria-current={isActive(href) ? 'page' : undefined}
            aria-haspopup={submenu ? 'true' : undefined}
            aria-expanded={submenu ? 'false' : undefined}
            href={href}
          >
            {label}
            {submenu && <ChevronIcon class="submenu-chevron ml-1.5 h-3 w-3" />}
          </a>
          {submenu && (
            <ul class="header-dropdown" aria-label={`${label} submenu`}>
              {submenu.map(({ href: subHref, label: subLabel }) => (
                <li>
                  <a
                    class:list={["header-dropdown-link", isActive(subHref) && 'is-current']}
                    aria-current={isActive(subHref) ? 'page' : undefined}
                    href={subHref}
                  >
                    {subLabel}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
  <ActionLink variant="header" badge class="header-cta hidden md:inline-flex" href="/vendor-registration">Vendor registration</ActionLink>
  <button class="mobile-menu-toggle md:hidden" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open navigation menu" data-mobile-menu-trigger>
    <span></span><span></span><span></span>
  </button>

  <dialog class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" data-mobile-menu>
    <div class="mobile-menu__panel">
      <div class="mobile-menu__top">
        <span class="text-sm font-semibold text-[var(--brand-dark)]">Menu</span>
        <form method="dialog">
          <button class="mobile-menu__close" type="submit" aria-label="Close navigation menu">×</button>
        </form>
      </div>
      <nav aria-label="Mobile navigation">
        <ul class="m-0 grid list-none gap-1 p-0">
          {navigation.map(({ href, label, submenu }) => (
            <li>
              {submenu ? (
                <details class="mobile-menu__details">
                  <summary>{label}<ChevronIcon class="h-3 w-3" /></summary>
                  <ul class="m-0 grid list-none gap-1 px-4 pb-2 pt-1">
                    <li><a class:list={['mobile-menu__link mobile-menu__sublink', isActive(href) && 'is-current']} href={href}>All services</a></li>
                    {submenu.map(({ href: subHref, label: subLabel }) => (
                      <li><a class:list={['mobile-menu__link mobile-menu__sublink', isActive(subHref) && 'is-current']} href={subHref}>{subLabel}</a></li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a class:list={['mobile-menu__link', isActive(href) && 'is-current']} href={href}>{label}</a>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <ActionLink variant="header" badge class="mt-8 w-full justify-between" href="/vendor-registration">Vendor registration</ActionLink>
    </div>
  </dialog>
</header>

<style>
  .header-nav-item {
    align-self: stretch;
    display: flex;
    align-items: center;
  }

  :global(a.btn--header) {
    background: linear-gradient(88deg, #2a3f5f 0%, #427dd5 100%);
    color: white;
    font-size: 1rem;
    line-height: 1.375rem;
    padding: 7px 7px 7px 25px;
  }

  :global(a.btn--header .btn__badge) {
    height: 2.25rem;
    width: 2.25rem;
  }

  :global(a.btn--header:hover) {
    background: linear-gradient(88deg, #2a3f5f 0%, #427dd5 100%);
    opacity: 0.92;
  }

  :global(a.btn.header-cta) { display: none; }

  .header-nav-item--parent::after {
    content: '';
    position: absolute;
    inset: 100% 0 auto 0;
    height: 15px;
  }

  .header-dropdown {
    position: absolute;
    left: -20px;
    top: 100%;
    z-index: 30;
    background: #fff;
    border-radius: 7px;
    box-shadow: 0 10px 50px rgb(0 0 0 / 0.1);
    list-style-type: none;
    margin: 15px 0 0;
    min-width: 260px;
    padding: 20px 0;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s ease-in-out, margin 0.3s ease-in-out, visibility 0.3s ease-in-out;
  }

  .header-nav-item:hover > .header-dropdown,
  .header-nav-item:focus-within > .header-dropdown,
  .header-nav-item.is-open > .header-dropdown {
    visibility: visible;
    opacity: 1;
    margin-top: 0;
  }

  .header-nav-item:hover > :is(a) > .submenu-chevron,
  .header-nav-item.is-open > :is(a) > .submenu-chevron {
    transform: rotate(180deg);
  }

  .submenu-chevron { transition: transform 0.3s ease-in-out; }

  .header-dropdown-link {
    color: #3e4a5c;
    display: flex;
    font-size: 16px;
    font-weight: 500;
    line-height: 28px;
    padding: 5px 25px;
    position: relative;
    transition: color 0.3s ease-in-out, padding 0.3s ease-in-out;
    white-space: nowrap;
  }

  .header-dropdown-link::before {
    content: '';
    position: absolute;
    left: 25px;
    bottom: 2px;
    height: 1px;
    width: 0;
    background-color: #005a9e;
    transition: width 0.3s ease-in-out;
  }

  .header-dropdown li:hover > .header-dropdown-link,
  .header-dropdown-link:focus-visible,
  .header-dropdown-link.is-current {
    color: #005a9e;
    padding-left: 35px;
  }

  .header-dropdown li:hover > .header-dropdown-link::before,
  .header-dropdown-link:focus-visible::before,
  .header-dropdown-link.is-current::before { width: 50px; }

  .mobile-menu-toggle {
    align-items: center;
    background: var(--brand);
    border: 0;
    border-radius: 50%;
    color: white;
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    height: 2.75rem;
    justify-content: center;
    width: 2.75rem;
  }

  .mobile-menu-toggle span { background: currentColor; height: 2px; width: 1.125rem; }

  .mobile-menu {
    background: transparent;
    border: 0;
    height: 100dvh;
    margin: 0 0 0 auto;
    max-width: min(22rem, 92vw);
    padding: 0;
    width: 100%;
  }

  .mobile-menu::backdrop { background: rgb(26 37 71 / .55); }

  .mobile-menu__panel {
    background: white;
    box-shadow: -12px 0 32px rgb(0 0 0 / .16);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .mobile-menu__top { align-items: center; display: flex; justify-content: space-between; margin-bottom: 1.5rem; }

  .mobile-menu__close {
    align-items: center;
    background: var(--brand-gray);
    border: 0;
    border-radius: 50%;
    color: var(--brand-dark);
    display: flex;
    font-size: 1.75rem;
    height: 2.75rem;
    justify-content: center;
    line-height: 1;
    width: 2.75rem;
  }

  .mobile-menu__link,
  .mobile-menu__details summary {
    align-items: center;
    border-radius: .5rem;
    color: #3e4a5c;
    display: flex;
    font-size: 1rem;
    font-weight: 600;
    justify-content: space-between;
    min-height: 2.75rem;
    padding: .625rem .75rem;
    text-decoration: none;
  }

  .mobile-menu__link:hover,
  .mobile-menu__link:focus-visible,
  .mobile-menu__link.is-current,
  .mobile-menu__details summary:hover { background: #f0f5fd; color: var(--brand); }

  .mobile-menu__details summary { cursor: pointer; list-style: none; }
  .mobile-menu__details summary::-webkit-details-marker { display: none; }
  .mobile-menu__details[open] summary svg { transform: rotate(180deg); }
  .mobile-menu__details summary svg { transition: transform 180ms ease; }
  .mobile-menu__sublink { font-size: .875rem; font-weight: 500; min-height: 2.25rem; }

  @media (min-width: 48rem) {
    :global(a.btn.header-cta) { display: inline-flex; }
    .mobile-menu-toggle,
    .mobile-menu { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[aria-haspopup="true"]').forEach((trigger) => {
    const item = trigger.closest('li');
    if (!item) return;
    const setOpen = (open: boolean) => {
      item.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', String(open));
    };
    trigger.addEventListener('click', (event) => {
      if (window.matchMedia('(hover: hover)').matches) return;
      event.preventDefault();
      setOpen(!item.classList.contains('is-open'));
    });
  });

  const parentItems = Array.from(document.querySelectorAll('.header-nav-item--parent'));
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    parentItems.forEach((item) => {
      if (!item.contains(event.target as Node)) {
        item.classList.remove('is-open');
        item.querySelector('[aria-haspopup="true"]')?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const openItem = document.querySelector('.header-nav-item.is-open');
    if (!openItem) return;
    openItem.classList.remove('is-open');
    openItem.querySelector('[aria-haspopup="true"]')?.setAttribute('aria-expanded', 'false');
    (openItem.querySelector('a') as HTMLElement | null)?.focus();
  });

  const menu = document.querySelector<HTMLDialogElement>('[data-mobile-menu]');
  const menuTrigger = document.querySelector<HTMLButtonElement>('[data-mobile-menu-trigger]');
  if (menu && menuTrigger) {
    menuTrigger.addEventListener('click', () => {
      menu.showModal();
      menuTrigger.setAttribute('aria-expanded', 'true');
      menu.querySelector<HTMLButtonElement>('.mobile-menu__close')?.focus();
    });
    menu.addEventListener('close', () => {
      menuTrigger.setAttribute('aria-expanded', 'false');
      menuTrigger.focus();
    });
    menu.addEventListener('click', (event) => {
      if (event.target === menu) menu.close();
    });
  }
</script>
