---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VendorRegistrationPage from '@/components/sites/sendian-vendor-registration/VendorRegistrationPage.astro';
---

<BaseLayout
  title="Vendor Registration | Sendian Integrated Security Services"
  description="Join Sendian Integrated Security Services' vendor network."
  socialImage="/sites/sendian-vendor-registration/services-single05.jpg"
  breadcrumbs={[{ name: 'Vendor Registration', path: '/vendor-registration' }]}
>
  <section class="vendor-hero" aria-labelledby="page-title">
    <div class="vendor-hero__inner">
      <h1 id="page-title">Vendor Registration</h1>
    </div>
  </section>
  <nav class="vendor-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Vendor Registration</span>
  </nav>

  <VendorRegistrationPage />
</BaseLayout>

<style>
  .vendor-hero {
    align-items: center;
    background:
      linear-gradient(90deg, rgb(18 33 69 / 92%), rgb(18 33 69 / 88%)),
      url('/sites/sendian-vendor-registration/services-single05.jpg') center / cover;
    border-radius: 1.25rem 1.25rem 0 0;
    display: flex;
    margin: 1.5rem 2rem 0;
    min-height: 30rem;
  }

  .vendor-hero__inner {
    margin-inline: auto;
    max-width: 96rem;
    padding: 2rem;
    width: 100%;
  }

  .vendor-hero h1 {
    color: white;
    font-size: clamp(2.65rem, 4vw, 4.5rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
    margin: 0;
  }

  .vendor-breadcrumb {
    background: #f7f7fa;
    border-bottom: 1px solid #cdd2dc;
    border-radius: 0 0 1.25rem 1.25rem;
    color: #1a2547;
    display: flex;
    gap: .55rem;
    margin: 0 2rem;
    padding: 1.2rem;
  }

  .vendor-breadcrumb a { color: #d92d20; text-decoration: none; }
  .vendor-breadcrumb a:hover { text-decoration: underline; }

  @media (max-width: 47.9375rem) {
    .vendor-hero { margin: .5rem .5rem 0; min-height: 18.75rem; }
    .vendor-hero__inner { padding: 1.25rem; }
    .vendor-breadcrumb { font-size: .875rem; margin-inline: .5rem; padding: .8rem .9rem; }
  }
</style>
