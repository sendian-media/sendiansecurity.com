---
import FloatingWhatsApp from '@/components/ui/FloatingWhatsApp.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { about } from '@/data/about';
---

<BaseLayout title="About Us | Sendian Integrated Security Services" description="Sendian Integrated Security Services (SISS) is a Qatar-based systems integrator delivering integrated security, ELV, ICT, and automation solutions.">
  <div class="px-4 pt-6 lg:px-8">
    <div class="mb-16 flex flex-col overflow-hidden rounded-[32px] border border-gray-100 shadow-sm">
      <div class="about-hero relative flex h-[360px] w-full items-center">
        <div class="absolute right-[20%] top-[10%] size-[300px] rounded-full border border-white opacity-10" aria-hidden="true"></div>
        <div class="absolute right-[15%] top-[5%] size-[400px] rounded-full border border-white opacity-5" aria-hidden="true"></div>
        <div class="absolute bottom-[10%] left-[10%] grid gap-4 opacity-20" aria-hidden="true">
          <div class="h-4 w-24 rounded bg-white/20"></div>
          <div class="h-4 w-32 rounded bg-white/20"></div>
          <div class="h-4 w-16 rounded bg-white/20"></div>
        </div>
        <div class="container relative z-10 mx-auto px-8 lg:px-16">
          <h1 class="text-[2.5rem] font-bold leading-tight text-white sm:text-[68px]">{about.hero.title}</h1>
        </div>
      </div>
      <nav class="bg-[#F8F9FA] px-8 py-5 text-[15px] lg:px-16" aria-label="Breadcrumb">
        <a class="text-[#ef3e4a] hover:underline" href="/">{about.hero.breadcrumb === 'About us' ? 'Home' : about.hero.breadcrumb}</a>
        <span class="mx-2 text-gray-400" aria-hidden="true">/</span>
        <span class="text-[#3E4A5C]" aria-current="page">About us</span>
      </nav>
    </div>
  </div>

  <section class="mx-auto max-w-7xl px-6 py-12 lg:px-16">
    <div class="flex flex-col items-start gap-16 lg:flex-row">
      <div class="relative w-full pb-12 lg:w-5/12">
        <img class="relative z-10 h-[600px] w-[90%] rounded-[32px] object-cover shadow-sm" src={about.intro.mainImage} alt={about.intro.mainAlt} width="1024" height="1536" loading="lazy" decoding="async" />
        <img class="absolute -bottom-6 right-0 z-20 h-[280px] w-[70%] rounded-[32px] border-[12px] border-white object-cover shadow-md" src={about.intro.secondaryImage} alt={about.intro.secondaryAlt} width="850" height="930" loading="lazy" decoding="async" />
      </div>

      <div class="w-full pt-4 lg:w-7/12">
        <p class="mb-6"><span class="badge-outline uppercase">// {about.intro.badge}</span></p>
        <h2 class="mb-8 text-4xl font-bold leading-[1.1] text-[var(--link)] sm:text-[52px]" set:html={about.intro.title} />
        <div class="mb-8 text-[17px] leading-relaxed text-[#8f91ab]">
          {about.intro.paragraphs.map((paragraph) => <p class="mb-6 last:mb-0">{paragraph}</p>)}
        </div>

        <div class="mt-12 grid grid-cols-2 gap-6 md:grid-cols-4">
          {about.intro.features.map((feature) => (
            <div class="text-center">
              <div class="feature-icon-box"><img class="size-12" src={feature.icon} alt="" width="48" height="48" loading="lazy" decoding="async" /></div>
              <h3 class="text-sm font-semibold text-[#3E4A5C]">{feature.title}</h3>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mt-12 bg-gray-50 py-20">
    <div class="mx-auto flex max-w-7xl flex-col-reverse items-center gap-16 px-6 lg:flex-row lg:px-16">
      <div class="w-full lg:w-1/2">
        <p class="mb-6"><span class="badge-outline">// {about.technology.badge}</span></p>
        <h2 class="mb-6 text-4xl font-bold text-[var(--link)]">{about.technology.title}</h2>
        <p class="mb-8 text-lg leading-relaxed text-[#8f91ab]">{about.technology.description}</p>
        <div class="mt-8 flex flex-wrap gap-6">
          {about.technology.highlights.map((highlight) => (
            <div class="flex items-start gap-4">
              <div class="rounded-xl bg-white p-3 shadow-sm"><img class="size-10" src={highlight.icon} alt="" width="40" height="40" loading="lazy" decoding="async" /></div>
              <div>
                <h3 class="font-bold text-[#3E4A5C]">{highlight.title}</h3>
                <p class="mt-1 text-sm text-[#8f91ab]">{highlight.caption}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="w-full lg:w-1/2">
        <img class="mx-auto w-full max-w-md object-contain" src={about.technology.image} alt={about.technology.imageAlt} width="688" height="713" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <FloatingWhatsApp />
</BaseLayout>

<style is:global>
  .about-hero {
    background-color: #1a2235;
    background-image:
      radial-gradient(circle at right center, rgb(255 255 255 / 0.05) 0%, transparent 40%),
      radial-gradient(circle at left center, rgb(255 255 255 / 0.03) 0%, transparent 50%);
  }
  .badge-outline {
    border: 1px solid var(--highlight);
    border-radius: 999px;
    color: var(--highlight);
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.5rem 1.25rem;
  }
  .feature-icon-box {
    align-items: center;
    background: #f8f9fa;
    border-radius: 0.75rem;
    display: inline-flex;
    justify-content: center;
    margin-bottom: 0.9375rem;
    padding: 1.25rem;
  }
</style>
