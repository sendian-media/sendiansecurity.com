---
import { home } from '@/data/home';
import Eyebrow from './Eyebrow.astro';
---

<section id="news" class="scroll-mt-20 bg-white py-20">
  <div class="container mx-auto px-8 text-center">
    <Eyebrow class="fade-up d1">Latest news</Eyebrow>
    <h2 class="section-title fade-up d2">Ongoing <span class="text-[var(--brand)]">Projects and updates</span></h2>
  </div>

  <div class="container mx-auto grid grid-cols-1 gap-8 px-8 md:grid-cols-3">
    {home.news.map((article, index) => (
      <article class:list={['group', 'fade-up', `d${index + 3}`]}>
        <div class="relative mb-6 aspect-video overflow-hidden rounded-[10px]">
          <a href="/news" aria-label={article.title}>
            <img class={article.image.endsWith('.jpeg') ? 'size-full object-contain transition duration-500 group-hover:scale-105 motion-reduce:transition-none' : 'size-full object-cover transition duration-500 group-hover:scale-105 motion-reduce:transition-none'} src={article.image} alt={article.alt} width="768" height="432" loading="lazy" decoding="async" />
          </a>
          <p class="absolute right-4 top-4 m-0 rounded-full border border-gray-200 bg-white/90 px-3 py-1 text-xs font-medium backdrop-blur-sm">{article.category}</p>
        </div>
        <h3 class="mb-3 text-xl font-bold leading-snug text-[var(--brand-dark)] transition group-hover:text-[var(--brand)]">
          <a class="hover:text-[var(--brand)]" href="/news">{article.title}</a>
        </h3>
        <p class="m-0 text-sm text-gray-500">{article.date} · <a class="underline" href="/news">Read more</a></p>
      </article>
    ))}
  </div>
</section>
