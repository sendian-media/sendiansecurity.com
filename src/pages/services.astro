---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { servicesPage } from '@/data/services';
---

<BaseLayout title="Security Systems & ELV Solutions in Qatar | SISS" description="Explore SISS solutions for CCTV, access control, ELV, networking, smart parking, automation, AV and maintenance across Qatar." socialImage="/images/services/services-banner.jpg" breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Services', path: '/services' }]}>
  <section class="service-hero relative flex h-[350px] w-full items-center overflow-hidden rounded-b-[30px] shadow-lg md:h-[400px]" aria-label="Services banner">
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 md:px-20 home-reveal d1">
      <h1 class="text-5xl font-bold leading-tight text-white md:text-[68px]">{servicesPage.hero.title}</h1>
    </div>
  </section>

  <nav class="mb-20 w-full bg-[#F9FAFB] px-6 py-4 md:px-20" aria-label="Breadcrumb">
    <div class="mx-auto max-w-7xl text-sm">
      <a class="font-medium text-[#ef3e4a] hover:underline" href="/">Home</a>
      <span class="mx-2 text-gray-400" aria-hidden="true">/</span>
      <span class="text-gray-600" aria-current="page">Services</span>
    </div>
  </nav>

  <div class="mx-auto mb-24 max-w-7xl px-6 md:px-12">
    <div class="mb-16 flex flex-col items-center text-center home-reveal d1">
      <p class="mb-6"><span class="badge-outline-gray">// Our Services</span></p>
      <h2 class="max-w-2xl text-4xl font-bold leading-tight text-[#1E293B] md:text-[46px]">
        Integrated <span class="text-[#3B82F6]">Security</span><br />Solutions
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {servicesPage.cards.map((card, index) => (
        <a class="service-card group block home-reveal" style={`--reveal-delay: ${(index % 2 === 0 ? 200 : 400)}ms`} href={card.href}>
          <img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" src={card.image} alt={card.alt} width="1920" height="1080" loading="lazy" decoding="async" />
          <h3 class="service-card-title">
            {card.titleLines.map((line, index) => (
              <>{index > 0 && <br />}{line}</>
            ))}
          </h3>
        </a>
      ))}
    </div>
  </div>

  <section class="home-reveal d5 border-y border-[var(--line)] bg-[#f8f8fa] pb-28 pt-12">
    <div class="mx-auto grid max-w-[90rem] grid-cols-1 gap-8 px-8 md:grid-cols-4 md:gap-6">
      {servicesPage.stats.map((stat) => (
        <div class="stat-item border-t border-[var(--line)] pt-7">
          <p class="m-0 flex items-center text-[3.5rem] font-bold leading-none text-[var(--brand-dark)] sm:text-[4rem]">
            <span class="stat-counter" data-to={stat.value} data-delimiter={stat.value.length > 3 ? ',' : ''}>{stat.value.length > 3 ? Number(stat.value).toLocaleString('en-US') : stat.value}</span><span class="stat-suffix">{stat.suffix}</span>
          </p>
          <p class="mt-7 text-xl font-bold leading-tight text-[var(--brand-dark)]">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>

<script>
  const counters = document.querySelectorAll<HTMLElement>('.stat-counter');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const render = (el: HTMLElement, value: number, delimiter: string) => {
    el.textContent = delimiter ? value.toLocaleString('en-US') : String(value);
  };

  const animate = (el: HTMLElement) => {
    const to = Number(el.dataset.to ?? '0');
    const delimiter = el.dataset.delimiter ?? '';
    if (reduced || !Number.isFinite(to)) {
      render(el, to, delimiter);
      return;
    }
    const duration = 2000;
    const start = performance.now();
    el.textContent = '0';
    const step = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      render(el, Math.round(to * eased), delimiter);
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          observer.unobserve(entry.target);
          animate(entry.target as HTMLElement);
        }
      }
    },
    { threshold: 0.4 },
  );
  counters.forEach((el) => observer.observe(el));
</script>

<style is:global>
  .service-hero {
    background-color: #2c3a55;
    background-image:
      url('/images/services/services-banner.jpg'),
      radial-gradient(circle at 70% 50%, rgb(255 255 255 / 0.05) 0%, transparent 50%),
      radial-gradient(circle at 30% 80%, rgb(255 255 255 / 0.03) 0%, transparent 40%);
    background-blend-mode: overlay, normal, normal;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .service-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(26 37 71 / 0.78);
  }
  .badge-outline-gray {
    border: 1px solid #d1d5db;
    border-radius: 9999px;
    color: #6b7280;
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 0.375rem 1rem;
    text-transform: uppercase;
  }
  .service-card {
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    isolation: isolate;
  }
  .service-card::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60%;
    background: linear-gradient(to top, rgb(0 0 0 / 0.8) 0%, transparent 100%);
    z-index: 1;
  }
  .service-card-title {
    color: white;
    font-family: 'Wix Madefor Display', sans-serif;
    font-size: 24px;
    font-weight: 600;
    left: 20px;
    bottom: 20px;
    line-height: 1.2;
    position: absolute;
    right: 20px;
    z-index: 2;
  }

  .stat-suffix { background: linear-gradient(216deg, #1c2e4a, #427dd5); background-clip: text; -webkit-background-clip: text; color: transparent; }

  @media (max-width: 767px) {
    .stat-item + .stat-item { padding-top: 2rem; }
  }

  @media (min-width: 96rem) {
    .service-hero ~ .mx-auto.max-w-7xl { max-width: 90rem; }
    .service-hero ~ .mx-auto.max-w-7xl h2 { font-size: clamp(3.2rem, 3.25vw, 3.5rem); }
    .service-hero ~ .mx-auto.max-w-7xl .service-card-title { font-size: 1.625rem; }
  }
</style>
