---
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import FloatingWhatsApp from '@/components/ui/FloatingWhatsApp.astro';
import CursorFollower from '@/components/ui/CursorFollower.astro';
import SeoHead, { type PageSchema } from '@/components/seo/SeoHead.astro';
import HomeMotion from '@/components/home/HomeMotion.astro';
import AnalyticsConsent from '@/components/analytics/AnalyticsConsent.astro';
import '@/styles/global.css';

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  socialImage?: string;
  breadcrumbs?: BreadcrumbItem[];
  schemas?: PageSchema[];
  localOnly?: boolean;
}

const { title, description, noindex, socialImage, breadcrumbs, schemas, localOnly = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/android-chrome-192x192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <SeoHead title={title} description={description} noindex={noindex} socialImage={socialImage} breadcrumbs={breadcrumbs} schemas={schemas} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer localOnly={localOnly} />
    <FloatingWhatsApp localOnly={localOnly} />
    <CursorFollower />
    <HomeMotion />
    <AnalyticsConsent />
  </body>
</html>
