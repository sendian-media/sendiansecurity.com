---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Sendian Security" description="The requested page was not found." noindex>
  <section class="container py-16 sm:py-24">
    <h1 class="text-4xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-4 text-lg text-[var(--muted)]">The page you requested does not exist.</p>
    <a class="button mt-8" href="/">Return home</a>
  </section>
</BaseLayout>
