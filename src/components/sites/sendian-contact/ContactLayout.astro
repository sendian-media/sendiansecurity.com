---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isContact = currentPath === '/contact';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Contact | Sendian Integrated Security Services</title>
    <meta name="description" content="Contact Sendian Integrated Security Services in this local preview." />
  </head>
  <body class="contact-shell">
    <a class="contact-skip" href="#contact-main">Skip to contact content</a>
    <header class="contact-header">
      <a class="contact-brand" href="/" aria-label="Sendian Integrated Security Services home">
        <img src="/sites/sendian-contact/images/logo-header.png" alt="Sendian Integrated Security Services" width="1188" height="668" />
      </a>
      <nav class="contact-desktop-nav" aria-label="Primary navigation">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/services">Services</a>
        <span aria-current={isContact ? 'page' : undefined} class:list={{ active: isContact }}>Contact</span>
      </nav>
      <a class="contact-cta" href="/contact">Vendor registration</a>
      <details class="contact-mobile-nav">
        <summary><span class="sr-only">Open navigation</span><span aria-hidden="true">☰</span></summary>
        <nav aria-label="Mobile navigation">
          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="/services">Services</a>
          <a href="/contact" aria-current={isContact ? 'page' : undefined}>Contact</a>
          <a href="/contact">Vendor registration</a>
        </nav>
      </details>
    </header>
    <slot />
    <footer class="contact-footer">
      <div class="contact-footer-grid">
        <section>
          <img class="contact-footer-logo" src="/sites/sendian-contact/images/logo-footer.png" alt="Sendian Integrated Security Services" width="768" height="432" loading="lazy" decoding="async" />
          <p>Ministry of Interior-approved security solutions provider. Protecting Qatar’s infrastructure with cutting-edge CCTV, access control, and enterprise security systems for more than a decade.</p>
          <p class="contact-socials" aria-label="Social profiles"><span>Facebook</span><span>Instagram</span><span>LinkedIn</span></p>
        </section>
        <nav aria-label="Footer quick links">
          <h2>Quick Links</h2>
          <a href="/about">About us</a>
          <a href="/services">Services</a>
          <span>Projects</span>
          <span>News</span>
          <a href="/contact">Vendor Registration</a>
          <a href="/contact">Contact</a>
        </nav>
        <section>
          <h2>E-Mail:</h2>
          <p>info@sendiansecurity.com</p>
          <h2>Address:</h2>
          <p>1st Floor, Office 01, Building 60, Mekkah Al Mukarramah Street, Luqta, Doha</p>
        </section>
      </div>
      <div class="contact-footer-bottom">
        <p>© Copyright {year} Sendian Security</p>
        <nav aria-label="Footer legal links"><a href="/terms">Terms and Conditions</a><a href="/privacy">Privacy policy</a><a href="/contact">Help</a></nav>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #fff; }
  :global(body) { margin: 0; }
  .contact-shell { color: #1a2547; font-family: "Wix Madefor Display", "DM Sans", ui-sans-serif, system-ui, sans-serif; }
  .contact-skip { background: #1a2547; color: #fff; left: 1rem; padding: .75rem 1rem; position: fixed; top: -5rem; z-index: 100; }
  .contact-skip:focus { top: 1rem; }
  .contact-header { align-items: center; background: #fff; box-shadow: 0 1px 18px rgb(26 37 71 / 8%); display: flex; gap: 2rem; justify-content: space-between; min-height: 90px; padding: 15px 50px; position: sticky; top: 0; z-index: 30; }
  .contact-brand { display: block; flex: 0 1 230px; }
  .contact-brand img { display: block; height: auto; max-height: 54px; max-width: 100%; object-fit: contain; width: auto; }
  .contact-desktop-nav { align-items: center; display: flex; gap: clamp(1rem, 2vw, 2rem); justify-content: center; }
  .contact-desktop-nav a, .contact-desktop-nav span, .contact-cta, .contact-mobile-nav a { color: #1a2547; font: 600 .78rem/1.2 "DM Sans", ui-sans-serif, system-ui, sans-serif; letter-spacing: .06em; text-decoration: none; text-transform: uppercase; }
  .contact-desktop-nav a:hover, .contact-desktop-nav .active { color: #427dd5; }
  .contact-cta { background: linear-gradient(90deg, #2a3f5f, #3e4a5c); border-radius: 999px; color: #fff; padding: .85rem 1.2rem; white-space: nowrap; }
  .contact-cta:hover { background: #427dd5; }
  .contact-mobile-nav { display: none; position: relative; }
  .contact-mobile-nav summary { cursor: pointer; font-size: 1.6rem; list-style: none; }
  .contact-mobile-nav summary::-webkit-details-marker { display: none; }
  .contact-mobile-nav nav { background: #fff; box-shadow: 0 12px 30px rgb(26 37 71 / 16%); display: grid; gap: .25rem; padding: 1rem; position: absolute; right: 0; top: calc(100% + .75rem); width: min(320px, calc(100vw - 30px)); }
  .contact-mobile-nav a { padding: .8rem; }
  .contact-footer { background: #1a2547; color: #fff; padding: 100px 50px 26px; }
  .contact-footer-grid { display: grid; gap: 4rem; grid-template-columns: minmax(0, 1fr) minmax(180px, .7fr) minmax(220px, .7fr); margin: 0 auto 4rem; max-width: 1430px; }
  .contact-footer-logo { display: block; height: auto; margin-bottom: 1.5rem; max-width: 60%; }
  .contact-footer p { color: #d9deea; font: 400 .95rem/1.75 "DM Sans", ui-sans-serif, system-ui, sans-serif; margin: 0; }
  .contact-footer h2 { font-size: 1.05rem; margin: 0 0 1rem; }
  .contact-footer nav:not(.contact-mobile-nav nav) { display: grid; gap: .8rem; align-content: start; }
  .contact-footer a, .contact-footer span { color: #d9deea; font: 400 .95rem/1.4 "DM Sans", ui-sans-serif, system-ui, sans-serif; text-decoration: none; }
  .contact-footer a:hover { color: #fff; }
  .contact-socials { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem !important; }
  .contact-socials span { border: 1px solid rgb(255 255 255 / 45%); border-radius: 999px; padding: .45rem .7rem; }
  .contact-footer-bottom { border-top: 1px solid rgb(255 255 255 / 20%); display: flex; font-size: .8rem; gap: 1rem; justify-content: space-between; margin: auto; max-width: 1430px; padding-top: 1.5rem; }
  .contact-footer-bottom nav { display: flex; gap: 1rem; }
  .sr-only { height: 1px; margin: -1px; overflow: hidden; position: absolute; width: 1px; clip: rect(0, 0, 0, 0); }
  @media (max-width: 1199px) { .contact-header { padding-inline: 20px; } .contact-desktop-nav, .contact-cta { display: none; } .contact-mobile-nav { display: block; } }
  @media (max-width: 1024px) { .contact-footer { padding: 70px 30px 26px; } .contact-footer-grid { grid-template-columns: 1fr 1fr; } .contact-footer-grid > :first-child { grid-column: 1 / -1; } }
  @media (max-width: 767px) { .contact-header { min-height: 70px; padding-inline: 15px; } .contact-brand { max-width: 210px; } .contact-brand img { max-height: 35px; } .contact-footer { padding: 60px 15px 24px; } .contact-footer-grid { gap: 2.5rem; grid-template-columns: 1fr; } .contact-footer-grid > :first-child { grid-column: auto; } .contact-footer-bottom { align-items: flex-start; flex-direction: column; } .contact-footer-bottom nav { flex-wrap: wrap; } }
</style>
