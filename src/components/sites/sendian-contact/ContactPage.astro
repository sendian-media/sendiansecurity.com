<main id="contact-main">
  <div class="contact-breadcrumb"><div><a href="/">Home</a><span aria-hidden="true">/</span><strong>Contact</strong></div></div>
  <section class="contact-section" aria-labelledby="contact-title">
    <div class="contact-grid">
      <div class="contact-information">
        <p class="contact-eyebrow fade-up">Contact us now!</p>
        <h1 class="fade-up" id="contact-title">Have questions? <span>Get in touch!</span></h1>
        <p class="contact-intro fade-up">We are here to assist you with all your inquiries.</p>
        <section class="contact-office fade-up" aria-labelledby="office-title">
          <h2 id="office-title">Head office</h2>
          <p>P.O. Box 1805, 60 Makkah St., Doha, Qatar</p>
          <p>+974 44866766</p>
          <p>+974 74720643</p>
          <p>info@sendiansecurity.com</p>
        </section>
      </div>
      <section class="contact-card fade-up" aria-labelledby="form-title">
        <p class="contact-eyebrow">Get in touch</p>
        <h2 id="form-title">Ready to get started?</h2>
        <p class="contact-preview-note" id="preview-note">Local preview only. Messages cannot be sent.</p>
        <fieldset aria-describedby="preview-note">
          <legend class="sr-only">Contact details</legend>
          <div class="contact-name-fields">
            <label>First Name*<input autocomplete="given-name" maxlength="400" aria-required="true" /></label>
            <label>Last Name*<input autocomplete="family-name" maxlength="400" aria-required="true" /></label>
          </div>
          <label>Email*<input type="email" autocomplete="email" maxlength="400" aria-required="true" /></label>
          <label>Phone*<input type="tel" autocomplete="tel" maxlength="400" aria-required="true" /></label>
          <label>Message<textarea rows="4" maxlength="2000"></textarea></label>
          <button type="button" disabled>Send Message — unavailable</button>
        </fieldset>
      </section>
    </div>
  </section>
  <section class="contact-map-section" aria-labelledby="location-title">
    <div class="contact-map fade-up">
      <div>
        <p class="contact-eyebrow">Our location</p>
        <h2 id="location-title">Visit our head office</h2>
        <p>Sendian Group building 60, zone 52, street 850, Doha, Qatar</p>
        <p class="contact-map-note">Map unavailable in this local preview.</p>
      </div>
    </div>
  </section>
</main>

<style>
