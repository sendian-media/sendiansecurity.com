---
import { home } from '@/data/home';
import { site } from '@/data/site';
import ActionLink from '@/components/ui/ActionLink.astro';
import PhoneIcon from '@/components/ui/PhoneIcon.astro';
import MailIcon from '@/components/ui/MailIcon.astro';

const heroSlides = [
  '/sites/sendiansecurity-com/images/hero-slide-1.webp',
  '/sites/sendiansecurity-com/images/hero-slide-2.webp',
  '/sites/sendiansecurity-com/images/hero-slide-3.webp',
];
---

<section class="home-hero cam-corners relative isolate flex w-full items-center overflow-hidden text-white">
  <div class="hero-slides absolute inset-0" aria-hidden="true">
    {heroSlides.map((image) => <span class="hero-slide" style={`background-image: url(${image})`}></span>)}
  </div>
  <div class="absolute inset-0 z-[1] bg-slate-950/45" aria-hidden="true"></div>
  <div class="camera-corner camera-corner--tl z-[2]" aria-hidden="true"></div>
  <div class="camera-corner camera-corner--tr z-[2]" aria-hidden="true"></div>
  <div class="camera-corner camera-corner--bl z-[2]" aria-hidden="true"></div>
  <div class="camera-corner camera-corner--br z-[2]" aria-hidden="true"></div>

  <p class="absolute left-10 top-10 z-[2] m-0 hidden items-center gap-2 font-mono text-sm md:flex" aria-hidden="true">
    <span class="rec-dot size-3 rounded-full bg-red-500"></span>Rec
  </p>
  <p class="absolute right-10 top-10 z-[2] m-0 hidden font-mono text-sm md:block" aria-hidden="true">19:20:00</p>

  <div class="hero-inner absolute inset-0 z-10 mx-auto flex w-full max-w-none flex-col justify-center gap-8 px-6 md:px-10 lg:items-start lg:px-6 lg:-translate-y-8">
    <div class="hero-copy max-w-[1040px]">
      <p class="m-0 inline-block rounded-full border border-white/30 bg-black/10 px-4 py-1.5 text-sm uppercase tracking-wider backdrop-blur-sm fade-up d1">// {home.hero.eyebrow}</p>
      <h1 class="m-0 text-[2.5rem] font-bold uppercase leading-tight tracking-normal sm:text-[49px] lg:text-[51px] lg:leading-[1.5] fade-up">{home.hero.title}</h1>
      <p class="m-0 max-w-[820px] text-lg leading-relaxed text-gray-200 fade-up d6">{home.hero.description}</p>
      <div class="hero-actions fade-up d8">
        <ActionLink href="/about" badge class="hero-cta">Request a consultation</ActionLink>
        <ActionLink href="/services" variant="secondary" class="hero-cta">Explore our solutions</ActionLink>
      </div>
    </div>

    <div class="hidden gap-4 md:grid md:grid-cols-2 lg:absolute lg:right-6 lg:bottom-10 lg:w-80 lg:grid-cols-1" aria-label="Contact details">
      <div class="contact-card fade-right d5">
        <span class="contact-card__icon"><PhoneIcon /></span>
        <span><span class="contact-card__label block">Call Us</span><b class="font-semibold">{site.phone}</b></span>
      </div>
      <div class="contact-card fade-right d7">
        <span class="contact-card__icon"><MailIcon /></span>
        <span><span class="contact-card__label block">Email</span><b class="font-semibold">{site.email}</b></span>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero {
    height: calc(100svh - 7.125rem);
    min-height: 0;
    overflow: clip;
    contain: paint;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.25rem, 2vw, 2rem);
  }

  .hero-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 17.5rem));
    gap: 1rem;
  }

  :global(.hero-cta) {
    box-sizing: border-box;
    justify-content: center;
    min-height: 3.75rem;
    width: 100%;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    background-position: center;
    background-size: cover;
    animation: hero-slide 9s ease-in-out infinite;
    will-change: opacity, transform;
  }

  .hero-slide:nth-child(1) { animation-delay: -2s; }
  .hero-slide:nth-child(2) { animation-delay: 1s; }
  .hero-slide:nth-child(3) { animation-delay: 4s; }

  @keyframes hero-slide {
    0% { opacity: 0; transform: scale(1.08); }
    22.22%, 33.33% { opacity: 1; transform: scale(1); }
    55.56%, 100% { opacity: 0; transform: scale(1.08); }
  }

  @media (max-width: 1023px) {
    .home-hero { height: calc(100svh - 6.25rem); }
  }

  @media (max-width: 639px) {
    .hero-actions {
      grid-template-columns: minmax(0, 17.5rem);
      gap: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide { animation: none; transform: none; }
    .hero-slide:first-child { opacity: 1; }
  }
</style>
