<section class="vendor-registration" aria-labelledby="vendor-registration-title">
  <div class="vendor-registration__grid">
    <div class="vendor-registration__introduction home-reveal d1">
      <p class="vendor-registration__eyebrow">// Partner with SISS</p>
      <h2 id="vendor-registration-title">Become A Partner. <span>Join Our Vendor Network!</span></h2>
      <p class="vendor-registration__summary">We are looking for qualified vendors, suppliers, and contractors to join our network. Register today to explore partnership opportunities with Qatar&apos;s leading MOI-approved security solutions provider.</p>

      <section class="vendor-registration__office" aria-labelledby="head-office-title">
        <h3 id="head-office-title">Head Office</h3>
        <address>
          <p>P.O. Box 1805, 60 Makkah St., Doha, Qatar</p>
          <p>+974 44866766</p>
          <p>+974 74720643</p>
          <p>info@sendiansecurity.com</p>
        </address>
      </section>
    </div>

    <section class="vendor-registration__card home-reveal d3" aria-labelledby="registration-form-title">
      <p class="vendor-registration__eyebrow">// Vendor Registration</p>
      <h2 id="registration-form-title">Register <span>Your</span> Company</h2>
      <p class="vendor-registration__notice" id="registration-notice" role="status">Local preview only. Registration cannot be submitted.</p>

      <fieldset aria-describedby="registration-notice">
        <legend class="sr-only">Vendor registration details</legend>
        <div class="vendor-registration__fields">
          <div class="vendor-registration__field vendor-registration__field--full">
            <label for="full-name">Full Name*</label>
            <input id="full-name" name="full-name" type="text" autocomplete="name" required />
          </div>
          <div class="vendor-registration__field">
            <label for="email-address">Email Address*</label>
            <input id="email-address" name="email-address" type="email" autocomplete="email" inputmode="email" required />
          </div>
          <div class="vendor-registration__field">
            <label for="phone-number">Phone Number* (+974)</label>
            <input id="phone-number" name="phone-number" type="tel" autocomplete="tel" inputmode="tel" required />
          </div>
          <div class="vendor-registration__field vendor-registration__field--full">
            <label for="company-name">Company Name*</label>
            <input id="company-name" name="company-name" type="text" autocomplete="organization" required />
          </div>
          <div class="vendor-registration__field vendor-registration__field--full">
            <label for="company-type">Company Type*</label>
            <select id="company-type" name="company-type" required>
              <option value="" selected disabled>Select company type</option>
              <option>Supplier</option>
              <option>Contractor</option>
              <option>Service Provider</option>
              <option>Manufacturer</option>
              <option>Distributor</option>
              <option>Other</option>
            </select>
          </div>
          <div class="vendor-registration__field vendor-registration__field--full">
            <label for="service-category">Products/Services Category*</label>
            <select id="service-category" name="service-category" required>
              <option value="" selected disabled>Select products/services category</option>
              <option>CCTV &amp; Surveillance Systems</option>
              <option>Access Control Systems</option>
              <option>Fire Detection &amp; Alarms</option>
              <option>Networking &amp; IT Infrastructure</option>
              <option>ELV Systems</option>
              <option>Installation Services</option>
              <option>Maintenance Services</option>
              <option>Hardware &amp; Equipment</option>
              <option>Software Solutions</option>
              <option>Other</option>
            </select>
          </div>
          <div class="vendor-registration__field vendor-registration__field--full">
            <label for="company-overview">Company Overview* <span>(Brief description of your company)</span></label>
            <input id="company-overview" name="company-overview" type="text" required />
          </div>
          <label class="vendor-registration__acceptance" for="acceptance-terms">
            <input id="acceptance-terms" name="acceptance-terms" type="checkbox" required />
            <span>I agree to be contacted by SISS regarding vendor partnership opportunities*</span>
          </label>
        </div>
        <button type="button" disabled aria-describedby="registration-notice">Submit Registration</button>
      </fieldset>
    </section>
  </div>
</section>

<style>
  .vendor-registration { margin: 6.25rem auto 10rem; max-width: 96rem; padding-inline: 1rem; }
  .vendor-registration__grid { align-items: start; display: grid; gap: 3.5rem; grid-template-columns: minmax(0, 1fr) 40rem; }
  .vendor-registration__introduction { background: #fff; padding: 1.5rem 5rem 1.5rem 0; }
  .vendor-registration__eyebrow { border: 1px solid #2462bf; border-radius: 999px; color: #2462bf; display: inline-block; font: 700 .75rem/1.2 'DM Sans', ui-sans-serif, system-ui, sans-serif; letter-spacing: .12em; margin: 0 0 1.2rem; padding: .38rem 1rem; text-transform: uppercase; }
  .vendor-registration h2 { color: #1d2b52; font-family: 'Wix Madefor Display', ui-sans-serif, system-ui, sans-serif; font-size: clamp(2.1rem, 4vw, 3.85rem); letter-spacing: -.045em; line-height: 1.08; margin: 0; max-width: 15ch; }
  .vendor-registration h2 span { color: #4b80d5; }
  .vendor-registration__summary { color: #596174; font: 500 1.1rem/1.72 'DM Sans', ui-sans-serif, system-ui, sans-serif; margin: 4.25rem 0 3rem; max-width: 33rem; }
  .vendor-registration__office { color: #596174; }
  .vendor-registration__office h3 { color: #3e4a5c; font-size: 1.15rem; margin: 0 0 .75rem; }
  .vendor-registration__office address { font-style: normal; }
  .vendor-registration__office p { font: 500 .95rem/1.85 'DM Sans', ui-sans-serif, system-ui, sans-serif; margin: 0; }
  .vendor-registration__office p:first-child { margin-bottom: 1.2rem; }

  .vendor-registration__card { background: #f7f7fa; border-radius: 1.8rem; padding: 2.25rem 2.5rem 3rem; }
  .vendor-registration__card .vendor-registration__eyebrow { margin-bottom: .85rem; }
  .vendor-registration__card h2 { font-size: clamp(2rem, 3vw, 2.45rem); max-width: none; }
  .vendor-registration__notice { color: #596174; font: 500 .875rem/1.45 'DM Sans', ui-sans-serif, system-ui, sans-serif; margin: .85rem 0 1.35rem; }
  fieldset { border: 0; margin: 0; min-inline-size: 0; padding: 0; }
  .vendor-registration__fields { display: grid; gap: .85rem; grid-template-columns: 1fr 1fr; }
  .vendor-registration__field { min-width: 0; }
  .vendor-registration__field--full, .vendor-registration__acceptance { grid-column: 1 / -1; }
  .vendor-registration__field label { color: #4c5877; display: block; font: 600 .78rem/1.3 'DM Sans', ui-sans-serif, system-ui, sans-serif; margin-bottom: .35rem; }
  .vendor-registration__field label span { font-weight: 400; }
  .vendor-registration input:not([type='checkbox']), .vendor-registration select { appearance: auto; background: white; border: 1px solid transparent; border-radius: .35rem; box-sizing: border-box; color: #1a2547; font: 400 1rem/1.3 'DM Sans', ui-sans-serif, system-ui, sans-serif; min-height: 3.25rem; padding: .75rem 1rem; width: 100%; }
  .vendor-registration input:not([type='checkbox']):focus, .vendor-registration select:focus { border-color: #0078d4; outline: 3px solid rgb(0 120 212 / 24%); outline-offset: 2px; }
  .vendor-registration__acceptance { align-items: start; background: white; border-radius: .35rem; color: #7c85a0; cursor: pointer; display: flex; font: 500 .9rem/1.5 'DM Sans', ui-sans-serif, system-ui, sans-serif; gap: .65rem; margin-top: .15rem; padding: 1rem 1.15rem; }
  .vendor-registration__acceptance input { accent-color: #405878; flex: none; height: 1.05rem; margin-top: .15rem; width: 1.05rem; }
  .vendor-registration button { background: #405878; border: 0; border-radius: 999px; color: white; cursor: not-allowed; font: 700 .85rem/1.2 'DM Sans', ui-sans-serif, system-ui, sans-serif; margin-top: 1.25rem; opacity: .8; padding: 1rem 1.5rem; text-transform: uppercase; width: 100%; }
  .vendor-registration button:focus-visible, .vendor-registration__acceptance:focus-within { outline: 3px solid var(--focus); outline-offset: 3px; }
  .sr-only { clip: rect(0, 0, 0, 0); height: 1px; margin: -1px; overflow: hidden; position: absolute; white-space: nowrap; width: 1px; }

  @media (max-width: 63.9375rem) { .vendor-registration { margin-block: 4.5rem 6rem; } .vendor-registration__grid { grid-template-columns: minmax(0, 1fr); } .vendor-registration__introduction { padding: 0; } .vendor-registration__summary { margin-top: 2rem; } .vendor-registration__card { max-width: 34rem; } }
  @media (max-width: 47.9375rem) { .vendor-registration { margin-block: 3.5rem 5rem; padding-inline: .5rem; } .vendor-registration__grid { gap: 2.5rem; } .vendor-registration h2 { font-size: 1.6rem; max-width: none; } .vendor-registration__summary { font-size: 1rem; margin: 2rem 0; } .vendor-registration__card { border-radius: 1.4rem; padding: 1.5rem; } .vendor-registration__fields { grid-template-columns: 1fr; } .vendor-registration__field--full, .vendor-registration__acceptance { grid-column: auto; } .vendor-registration input:not([type='checkbox']), .vendor-registration select { font-size: 1rem; } }
</style>
