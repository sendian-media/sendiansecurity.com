<section class="contact-section" aria-labelledby="contact-title">
  <div class="contact-grid">
    <div class="contact-information">
      <p class="contact-eyebrow home-reveal d1">Contact us now!</p>
      <h2 class="contact-heading home-reveal d2" id="contact-title">Have questions? <span>Get in touch!</span></h2>
      <p class="contact-intro home-reveal d3">We are here to assist you with all your inquiries.</p>
      <section class="contact-office home-reveal d3" aria-labelledby="office-title">
        <h3 id="office-title">Head office</h3>
        <p>P.O. Box 1805, 60 Makkah St., Doha, Qatar</p>
        <p>+974 44866766</p>
        <p>+974 74720643</p>
        <p>info@sendiansecurity.com</p>
      </section>
    </div>
    <section class="contact-form-card home-reveal d5" aria-labelledby="form-title">
      <p class="contact-eyebrow">Get in touch</p>
      <h2 id="form-title">Ready to get started?</h2>
      <form class="contact-form" data-hubspot-contact-form>
        <div class="contact-name-fields">
          <label>First Name*<input name="firstname" autocomplete="given-name" maxlength="400" required /></label>
          <label>Last Name*<input name="lastname" autocomplete="family-name" maxlength="400" required /></label>
        </div>
        <label>Email*<input name="email" type="email" autocomplete="email" maxlength="400" required /></label>
        <label>Phone number<input name="phone" type="tel" autocomplete="tel" maxlength="400" /></label>
        <label>Message<textarea name="message" rows="4" maxlength="2000"></textarea></label>
        <input name="contact_from" type="hidden" value="Sendian_Security" />
        <p class="contact-form-status" data-form-status role="status" aria-live="polite" hidden></p>
        <button type="submit">Send Message</button>
      </form>
    </section>
  </div>
</section>
<section class="contact-map-section" aria-labelledby="location-title">
  <div class="contact-map home-reveal d5">
    <iframe
      class="contact-map__frame"
      title="Sendian Integrated Security Services location"
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3606.724560941799!2d51.463750176021286!3d25.313456626980738!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3e45db0c32c1d90f%3A0x8879e436e11ea0f0!2sSendian%20Integrated%20Security%20Services%20-%20SISS!5e0!3m2!1sen!2sqa!4v1791713035845!5m2!1sen!2sqa"
      width="600"
      height="450"
      allowfullscreen
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
    <div class="contact-map__details">
      <p class="contact-eyebrow">Our location</p>
      <h2 id="location-title">Visit our head office</h2>
      <p>Sendian Group building 60, zone 52, street 850, Doha, Qatar</p>
    </div>
  </div>
</section>

<style>
  .contact-section { margin: auto; max-width: 1530px; padding: 0 50px 120px; }
  .contact-grid { display: grid; gap: 24px; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .contact-information { align-self: start; padding: 1rem 7% 1rem 0; position: sticky; top: 120px; }
  .contact-eyebrow { border: 1px solid #3a6ade; border-radius: 999px; color: #3a6ade; display: inline-block; font: 700 .72rem/1.2 "DM Sans", ui-sans-serif, system-ui, sans-serif; letter-spacing: .12em; margin: 0 0 1.2rem; padding: 7px 19px; text-transform: uppercase; }
  .contact-heading { font-size: clamp(2.5rem, 3.65vw, 3.25rem); line-height: 1.19; margin: 0; max-width: 12ch; }
  .contact-heading span { background: linear-gradient(216deg, #1c2e4a, #427dd5); background-clip: text; -webkit-background-clip: text; color: transparent; }
  .contact-intro { color: #596174; font: 400 1.125rem/1.67 "DM Sans", ui-sans-serif, system-ui, sans-serif; margin: 1.5rem 0 3rem; max-width: 38ch; }
  .contact-office { border-left: 3px solid var(--highlight); padding-left: 1.25rem; }
  .contact-office h3 { color: var(--brand-dark); font-family: "Wix Madefor Display", ui-sans-serif, system-ui, sans-serif; font-size: 1.25rem; margin: 0 0 .75rem; }
  .contact-office p { color: #596174; font: 400 1rem/1.7 "DM Sans", ui-sans-serif, system-ui, sans-serif; margin: .15rem 0; }
  .contact-form-card { background: #f7f7fa; border-radius: 30px; padding: 50px 60px; }
  .contact-form-card h2 { color: var(--brand-dark); font-family: "Wix Madefor Display", ui-sans-serif, system-ui, sans-serif; font-size: clamp(1.75rem, 3vw, 2.625rem); line-height: 1.25; margin: 0 0 .75rem; }
  .contact-form { margin: 1.5rem 0 0; }
  label { color: var(--brand-dark); display: grid; font: 600 .9rem/1.4 "DM Sans", ui-sans-serif, system-ui, sans-serif; gap: .45rem; margin-bottom: 1.25rem; }
  input, textarea { background: #fff; border: 1px solid transparent; border-radius: 6px; color: var(--brand-dark); font: 400 1rem/1.5 "DM Sans", ui-sans-serif, system-ui, sans-serif; min-width: 0; padding: 15px 20px; resize: vertical; }
  input:focus, textarea:focus { border-color: #0078d4; outline: 3px solid rgb(0 120 212 / 24%); outline-offset: 2px; }
  .contact-name-fields { display: grid; gap: 1rem; grid-template-columns: 1fr 1fr; }
  .contact-form-status { border-radius: 6px; font: 500 .9rem/1.5 "DM Sans", ui-sans-serif, system-ui, sans-serif; margin: 0 0 1.25rem; padding: .875rem 1rem; }
  .contact-form-status.is-success { background: #eaf8ef; color: #166534; }
  .contact-form-status.is-error { background: #fef2f2; color: #b91c1c; }
  .contact-form button { background: linear-gradient(90deg, #2a3f5f, #3e4a5c); border: 0; border-radius: 999px; color: #fff; cursor: pointer; font: 700 .9rem/1.2 "DM Sans", ui-sans-serif, system-ui, sans-serif; padding: 1rem 1.5rem; transition: opacity 180ms ease, transform 180ms ease; width: 100%; }
  .contact-form button:hover:not(:disabled) { opacity: .9; }
  .contact-form button:active:not(:disabled) { transform: scale(.96); }
  .contact-form button:disabled { cursor: wait; opacity: .65; }
  .contact-map-section { padding: 0 50px 120px; }
  .contact-map { align-items: center; background: #d9dce3; border-radius: 20px; display: grid; min-height: 549px; overflow: hidden; padding: clamp(2rem, 6vw, 7rem); position: relative; }
  .contact-map__frame { border: 0; height: 100%; inset: 0; position: absolute; width: 100%; }
  .contact-map__details { background: rgb(255 255 255 / 92%); border-radius: 18px; box-shadow: 0 1.5rem 3.5rem rgb(26 37 71 / 22%); max-width: 500px; padding: 2rem; position: relative; z-index: 1; }
  .contact-map h2 { color: var(--brand-dark); font-family: "Wix Madefor Display", ui-sans-serif, system-ui, sans-serif; font-size: clamp(1.75rem, 3vw, 2.625rem); margin: 0 0 1rem; }
  .contact-map p:not(.contact-eyebrow) { color: #596174; font: 400 1rem/1.7 "DM Sans", ui-sans-serif, system-ui, sans-serif; margin: 0; }
  .sr-only { height: 1px; margin: -1px; overflow: hidden; position: absolute; width: 1px; clip: rect(0, 0, 0, 0); }
  @media (max-width: 1400px) { .contact-section { padding-block: 100px; } }
  @media (max-width: 1024px) { .contact-section { padding: 0 30px 70px; } .contact-grid { grid-template-columns: 1fr; } .contact-information { padding-right: 0; position: static; } .contact-form-card { margin-top: 50px; padding: 40px; } .contact-map-section { padding: 0 30px 70px; } .contact-map { min-height: 350px; } }
  @media (max-width: 767px) { .contact-section { padding: 0 15px 60px; } .contact-form-card { padding: 25px; } .contact-name-fields { grid-template-columns: 1fr; } .contact-map-section { padding: 0 15px 60px; } .contact-map { align-items: end; min-height: 360px; padding: 1.5rem; } .contact-map__details { padding: 1.5rem; } }
  @media (min-width: 96rem) {
    .contact-map-section { box-sizing: border-box; margin-inline: auto; max-width: 1530px; }
  }
</style>

<script>
  const hubSpotEndpoint = 'https://api.hsforms.com/submissions/v3/integration/submit/148999608/0ec48611-6e4a-4d9e-bf9a-7f51f9c7d061';

  document.querySelectorAll<HTMLFormElement>('[data-hubspot-contact-form]').forEach((form) => {
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    if (!submitButton || !status) return;

    const showStatus = (message: string, state: 'success' | 'error') => {
      status.textContent = message;
      status.className = `contact-form-status is-${state}`;
      status.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const formData = new FormData(form);
      const fields = ['firstname', 'lastname', 'email', 'phone', 'message', 'contact_from'].map((name) => ({
        name,
        value: String(formData.get(name) ?? ''),
      }));

      submitButton.disabled = true;
      submitButton.textContent = 'Sending…';
      status.hidden = true;

      try {
        const response = await fetch(hubSpotEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            fields,
            context: { pageUri: window.location.href, pageName: document.title },
          }),
        });

        if (!response.ok) throw new Error(`HubSpot submission failed (${response.status})`);
        form.reset();
        showStatus('Thank you. Your message has been sent.', 'success');
      } catch (error) {
        console.error('HubSpot contact form submission failed.', error);
        showStatus('Unable to send your message. Please try again.', 'error');
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Send Message';
      }
    });
  });
</script>
