---
import type {NewsArticleCard} from '@/lib/sanity/types';

interface Props {
  articles: NewsArticleCard[];
}

const {articles} = Astro.props;
const formatDate = (date: string) => new Intl.DateTimeFormat('en', {dateStyle: 'long'}).format(new Date(`${date}T00:00:00Z`));
---

<div class="mx-auto mb-24 max-w-7xl px-6 md:px-12">
  <div class="mb-16 flex flex-col items-center text-center">
    <p class="mb-6"><span class="badge-outline-gray">// Latest news</span></p>
    <h2 class="max-w-2xl text-4xl font-bold leading-tight text-[#1E293B] md:text-[46px]">
      News and <span class="text-[#3B82F6]">Updates</span>
    </h2>
  </div>

  {articles.length ? (
    <div class="news-grid">
      {articles.map((article, index) => (
        <article class:list={['news-card fade-up', `news-card--${index + 1}`]}>
          <div class="relative mb-6 aspect-video overflow-hidden rounded-[10px]">
            <img class="size-full object-cover transition duration-500 group-hover:scale-105 motion-reduce:transition-none" src={article.featuredImage.url} alt={article.featuredImage.alt} width="1024" height="576" loading="lazy" decoding="async" />
            <p class="absolute right-4 top-4 m-0 rounded-full border border-gray-200 bg-white/90 px-3 py-1 text-xs font-medium backdrop-blur-sm">{article.category}</p>
          </div>
          <h3 class="mb-3 text-xl font-bold leading-snug text-[var(--brand-dark)]">
            <a class="transition hover:text-[var(--brand)]" href={`/news/${article.id}`}>{article.title}</a>
          </h3>
          <p class="mb-3 text-sm text-gray-500">{formatDate(article.publishedAt)}</p>
          <p class="m-0 text-[15px] leading-relaxed text-[#8f91ab]">{article.summary}</p>
        </article>
      ))}
    </div>
  ) : (
    <p class="mx-auto max-w-xl text-center text-lg leading-relaxed text-slate-600">News updates will appear here soon.</p>
  )}
</div>

<style>
  .news-grid { display: grid; gap: 2.5rem 2rem; grid-template-columns: 1fr; }
  .news-card h3 a { text-decoration: none; }
  @media (min-width: 768px) { .news-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .news-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (prefers-reduced-motion: no-preference) {
    .fade-up { animation: news-fade-up 2s ease both; }
    .news-card--2 { animation-delay: 200ms; }
    .news-card--3 { animation-delay: 300ms; }
    .news-card--4 { animation-delay: 400ms; }
    .news-card--5 { animation-delay: 500ms; }
  }
  @keyframes news-fade-up {
    from { opacity: 0; transform: translateY(3rem); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
