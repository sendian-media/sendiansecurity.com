---
import { home } from '@/data/home';
import Eyebrow from './Eyebrow.astro';
import ActionLink from '@/components/ui/ActionLink.astro';
---

<section id="services" class="scroll-mt-20 bg-white py-20">
  <div class="container mx-auto px-8 text-center">
    <Eyebrow class="fade-up d1">Our services</Eyebrow>
    <h2 class="section-title mx-auto max-w-3xl fade-up d2">Comprehensive <span class="text-[var(--brand)]">Security &amp; Technology</span> Solutions</h2>
    <p class="mx-auto max-w-3xl text-gray-600 fade-up d3">From Ministry of Interior-approved CCTV surveillance to enterprise networking and smart infrastructure, SISS delivers integrated security solutions tailored to Qatar’s government, commercial, and industrial sectors.</p>
  </div>

  <div class="container mx-auto mt-12 grid grid-cols-1 gap-6 px-8 md:grid-cols-2 lg:grid-cols-4">
    {home.services.map((service, index) => (
      <article class:list={['group relative aspect-[4/5] overflow-hidden rounded-[10px]', `fade-up d${index + 3}`]}>
        <img class="size-full object-cover transition duration-500 group-hover:scale-110 motion-reduce:transition-none" src={service.image} alt={service.alt} width="800" height="950" loading="lazy" decoding="async" />
        <div class="service-card-overlay absolute inset-0 flex items-end p-6">
          <h3 class="w-3/4 text-xl font-bold leading-tight text-white">{service.title}</h3>
        </div>
      </article>
    ))}
  </div>

  <p class="mt-12 text-center fade-up d8"><ActionLink href="/services" badge>View all services</ActionLink></p>
</section>
