---
interface Props {
  title: string;
  breadcrumb: string;
}

const { title, breadcrumb } = Astro.props;
const hasSidebar = Astro.slots.has('sidebar');
---

<section class="legal-hero" aria-labelledby="page-title">
  <div class="legal-hero__inner">
    <h1 id="page-title">{title}</h1>
  </div>
</section>
<nav class="legal-breadcrumb" aria-label="Breadcrumb">
  <a href="/">Home</a>
  <span aria-hidden="true">/</span>
  <span aria-current="page">{breadcrumb}</span>
</nav>

<section class:list={['legal-content', hasSidebar && 'legal-content--with-sidebar']}>
  <article class="legal-copy">
    <slot />
  </article>
  {hasSidebar && (
    <aside class="legal-sidebar" aria-label="Privacy policy resources">
      <slot name="sidebar" />
    </aside>
  )}
</section>

<style>
  .legal-hero {
    align-items: center;
    background:
      linear-gradient(90deg, rgb(18 33 69 / 92%), rgb(18 33 69 / 88%)),
      url('/sites/sendiansecurity-com/legal/services-single05.jpg') center / cover;
    border-radius: 1.25rem 1.25rem 0 0;
    display: flex;
    margin: 1.5rem 2rem 0;
    min-height: 26.5rem;
  }

  .legal-hero__inner {
    margin-inline: auto;
    max-width: 80rem;
    padding: 2rem;
    width: 100%;
  }

  .legal-hero h1 {
    color: white;
    font-size: clamp(2.6rem, 4vw, 4.5rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
    margin: 0;
    max-width: 50rem;
  }

  .legal-breadcrumb {
    background: #f7f7fa;
    border-bottom: 1px solid #cdd2dc;
    border-radius: 0 0 1.25rem 1.25rem;
    color: #1a2547;
    display: flex;
    gap: .55rem;
    margin: 0 2rem;
    padding: 1.2rem;
  }

  .legal-breadcrumb a {
    color: #ef4444;
    text-decoration: none;
  }

  .legal-breadcrumb a:hover { text-decoration: underline; }

  .legal-content {
    column-gap: 4rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 3.5rem auto 5rem;
    max-width: 80rem;
    padding-inline: 2rem;
  }

  .legal-content--with-sidebar { grid-template-columns: minmax(0, 1fr) 17.5rem; }

  .legal-copy {
    color: #7b84a5;
    font-size: 1rem;
    line-height: 1.85;
  }

  .legal-copy :global(h2) {
    color: #17244a;
    font-size: clamp(1.4rem, 2.3vw, 2rem);
    letter-spacing: -0.04em;
    line-height: 1.25;
    margin: 0 0 .65rem;
  }

  .legal-copy :global(h2:not(:first-child)) { margin-top: 2rem; }

  .legal-copy :global(p) { margin: 0; }
  .legal-copy :global(p + p) { margin-top: 1rem; }
  .legal-copy :global(ul) { margin: .75rem 0 0; padding-left: 1.35rem; }
  .legal-copy :global(li + li) { margin-top: .25rem; }
  .legal-copy :global(strong) { color: #596586; }
  .legal-copy :global(a) { color: #46567d; text-underline-offset: .15em; }
  .legal-copy :global(.legal-effective-date) { font-weight: 700; margin-top: 1.75rem; }

  .legal-sidebar { display: grid; align-content: start; gap: 1.75rem; }

  @media (max-width: 63.9375rem) {
    .legal-content--with-sidebar { grid-template-columns: minmax(0, 1fr); }
    .legal-sidebar { margin-top: 3rem; }
  }

  @media (max-width: 47.9375rem) {
    .legal-hero { margin: .5rem .5rem 0; min-height: 18.75rem; }
    .legal-hero__inner { padding: 1.25rem; }
    .legal-breadcrumb { font-size: .875rem; margin-inline: .5rem; padding: .8rem .9rem; }
    .legal-content { margin-block: 3rem 4rem; padding-inline: 1.25rem; }
    .legal-copy { font-size: .9375rem; line-height: 1.75; }
    .legal-copy :global(h2:not(:first-child)) { margin-top: 1.75rem; }
  }
</style>
